# Upstream OpenAI-compatible gateway. Default is OpenRouter; override if you
# later migrate to direct-provider or a self-hosted gateway.
OPENMESH_BASE_URL=https://openrouter.ai/api/v1
OPENMESH_API_KEY=sk-or-v1-replace-me

# Optional: sent to OpenRouter as HTTP-Referer / X-Title for their dashboard.
OPENMESH_APP_URL=https://openmesh.ai
OPENMESH_APP_NAME=openmesh-bench

# Hugging Face Datasets target for public trace uploads.
HF_TOKEN=hf_replace_me
HF_DATASET_REPO=openmesh/bench-traces

# Default streaming behavior. CLI --stream / --no-stream override this.
OPENMESH_STREAM=0

# Where JSONL traces are written. One subdir per run_id.
OPENMESH_TRACES_DIR=./traces

# Hard spend caps in USD. Leave blank to disable a cap.
OPENMESH_MAX_USD_PER_TASK=
OPENMESH_MAX_USD_PER_MODEL=
OPENMESH_MAX_USD_PER_RUN=

OPENMESH_REQUEST_TIMEOUT_S=120
OPENMESH_MAX_RETRIES=3
